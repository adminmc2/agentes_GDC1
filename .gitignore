# macOS
.DS_Store

# Archivos temporales
~*

# Variables de entorno (API keys)
.env

# Python
__pycache__/
*.pyc
*.pkl

# Claude Code (local)
.claude/

# === Contenido editorial (no forma parte del sistema de agentes) ===

# Contenido de unidades (output editorial)
unidades/

# Material pedagógico de referencia (bancos de técnicas)
referencias/

# Materiales producidos (LaTeX, PDFs, tarjetas InDesign)
materiales/
material-complementario/
tarjetas/

# Documentos pedagógicos extensos
00-curso-general.md
marco-teorico-metodologico.md

# Prompts pedagógicos y repertorios (cambiarán con rediseño CrewAI)
agentes/
repertorios/

# Output de agentes (producto, no código)
datos/tarjetas/

# Resultados de pruebas obsoletas
scripts/resultados_prueba/

# Documentación interna de diseño (no interviene en deploy)
diseno/

