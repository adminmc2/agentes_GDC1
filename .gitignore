# macOS
.DS_Store

# Archivos temporales
~*

# LaTeX (archivos de compilacion)
*.aux
*.log
*.synctex.gz

# Archivos binarios pesados (diseno, maquetas, comprimidos)
*.ai
*.indd
*.psd
*.zip
*.rar

# Word (se trabaja en Markdown)
*.docx

# Variables de entorno (API keys)
.env

# Python
__pycache__/
*.pyc
*.pkl

# PDFs fuente del libro (binarios pesados, no versionables)
datos/fuente/**/*.pdf
