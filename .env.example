# === API Keys ===
# Obligatorias (al menos una para poder ejecutar agentes):
ANTHROPIC_API_KEY=tu-api-key-de-anthropic
GROQ_API_KEY=tu-api-key-de-groq
# Opcional (solo si usas modelos DeepSeek):
# DEEPSEEK_API_KEY=tu-api-key-de-deepseek

# === Base de datos (Neon PostgreSQL, obligatoria) ===
DATABASE_URL=postgresql://usuario:contraseña@host/basedatos

# === Langfuse (observabilidad, opcional) ===
# Crear cuenta gratis en cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=tu-public-key-langfuse
LANGFUSE_SECRET_KEY=tu-secret-key-langfuse
LANGFUSE_HOST=https://cloud.langfuse.com

# === DeepEval (opcional, para métricas LLM-based) ===
# Registro gratis en app.confident-ai.com para dashboard cloud
# Sin esta key, deepeval funciona en local sin dashboard
# DEEPEVAL_API_KEY=tu-api-key-deepeval

# === Servidor ===
PORT=8080
HOST=0.0.0.0

# === Crew Recurvo (3 agentes, cada uno con su LLM + parámetros) ===
# Cada agente puede usar un modelo y parámetros diferentes.
# Se configuran desde el dashboard o aquí como defaults.
# RECURVO_LLM se usa como fallback del generador si RECURVO_LLM_GEN no está definido.
#
# Modelos disponibles:
#   --- Groq (gratis, requiere GROQ_API_KEY) ---
#   groq/openai/gpt-oss-120b              — 131K ctx (probado, funciona)
#   groq/openai/gpt-oss-20b               — 131K ctx (más rápido)
#   groq/llama-3.3-70b-versatile          — 131K ctx (buen instruction-following)
#   groq/llama-3.1-8b-instant             — 131K ctx (ultra-rápido, ideal tools)
#   groq/meta-llama/llama-4-scout-17b-16e-instruct — 131K ctx (MoE)
#   groq/moonshotai/kimi-k2-instruct-0905 — 262K ctx (preview)
#   groq/qwen/qwen3-32b                   — 131K ctx (errores factuales)
#   --- Anthropic (requiere ANTHROPIC_API_KEY) ---
#   anthropic/claude-opus-4-20250514      — 200K ctx, $15/$75 per MTok
#   anthropic/claude-sonnet-4-20250514    — 200K ctx, $3/$15 per MTok
#   anthropic/claude-haiku-3-5-20241022   — 200K ctx, $0.80/$4 per MTok
#   --- DeepSeek (requiere DEEPSEEK_API_KEY) ---
#   deepseek/deepseek-chat                — 64K ctx, $0.27/$1.10 per MTok
#   deepseek/deepseek-reasoner            — 64K ctx, $0.55/$2.19 per MTok
#
# Generador: necesita el modelo más capaz (genera contenido lingüístico)
# RECURVO_LLM_GEN=groq/openai/gpt-oss-120b
# RECURVO_TEMP_GEN=0.7
# RECURVO_MAXTOK_GEN=8192
# RECURVO_TOPP_GEN=1.0
#
# Verificador: modelo mediano (compara datos, no necesita creatividad)
# RECURVO_LLM_VER=groq/llama-3.3-70b-versatile
# RECURVO_TEMP_VER=0.2
# RECURVO_MAXTOK_VER=8192
# RECURVO_TOPP_VER=1.0
#
# Escritor: modelo mínimo (solo ejecuta 2 tools)
# RECURVO_LLM_WR=groq/llama-3.1-8b-instant
# RECURVO_TEMP_WR=0.0
# RECURVO_MAXTOK_WR=2048
# RECURVO_TOPP_WR=1.0

# === Debug (opcional) ===
# DEBUG=1
