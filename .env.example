# === Configuración de repo A (dashboard local + validador) ===
# Repo A no usa agentes en su flujo vigente ni necesita claves de API.
# Todas las variables de abajo son OPCIONALES — el dashboard arranca sin .env.

# --- Servidor del dashboard (diagrama.py) ---
# PORT=8081
# HOST=0.0.0.0

# --- Escaneo de worktrees paralelos en el dashboard (opcional) ---
# Rutas extra de inventarios a mostrar, separadas por ':'
# EXTRA_UNIDADES_PATHS=/ruta/a/otro-worktree/unidades

# --- Depuración (opcional) ---
# DEBUG=1

# === Superficies heredadas y dormidas (BD + observabilidad) ===
# El dashboard conserva endpoints de BD (tarjetas, correcciones, reglas) y
# trazas Langfuse heredados del sistema de agentes. Esas superficies están
# fuera del flujo vigente de repo A; definir estas variables solo si se
# reactiva alguna.
# DATABASE_URL=postgresql://usuario:contraseña@host/basedatos
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
